# ------------------------------------------------------------------
# DONDE PONER LA API KEY DE GEMINI
# ------------------------------------------------------------------
#
# 1. Copia este fichero a ".env" en la raiz del proyecto:
#
#        Copy-Item .env.example .env
#
# 2. Abre ".env" y sustituye la linea de abajo por tu clave real:
#
#        GEMINI_API_KEY=AIzaSy...tu_clave_real...
#
# 3. Listo. src/transcribir.py la lee sola de ese fichero.
#
# Consigue la clave gratis en:  https://aistudio.google.com/apikey
#
# ".env" esta en .gitignore, asi que la clave nunca se sube al repositorio.
#
# ------------------------------------------------------------------
# Alternativa sin fichero .env, definiendo la variable en PowerShell
# antes de ejecutar el script:
#
#        $env:GEMINI_API_KEY = "AIzaSy...tu_clave_real..."
#
# La Web Speech API (metodo A) NO necesita esta clave: la gestiona
# Chrome por su cuenta.
# ------------------------------------------------------------------

GEMINI_API_KEY=pega_aqui_tu_clave
